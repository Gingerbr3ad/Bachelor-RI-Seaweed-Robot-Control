<?xml version="1.0" ?>
<robot name="gripper" xmlns:xacro="http://www.ros.org/wiki/xacro" >

<material name="silver">
  <color rgba="0.750 0.750 0.750 1.000"/>
</material>
<material name="red">
  <color rgba="0.700 0.000 0.000 1.000"/>
</material>
<material name="green">
  <color rgba="0.000 0.700 0.000 1.000"/>
</material>
<material name="black">
  <color rgba="0.250 0.250 0.250 1.000"/>
</material>

</robot>
